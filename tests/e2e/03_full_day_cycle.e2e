# @slow
# Test: one full day/night cycle.
# Day (planning) runs, the bar opens at night, customers spawn,
# the day counter increments, and transient customers clean up.
# Round lengths are real-time, so this takes minutes.

expect_game_state InGame within 90
expect_phase day within 30
expect_day 0 within 10

expect_phase night within 900
expect_day >= 1 within 60
expect_entity Customer >= 1 within 300

expect_entity Customer == 0 within 900
expect_day >= 1 within 10
